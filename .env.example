# ---------------------------------------------------------------------------
# Family Finance Tracker — environment variables
#
# 1. Copy this file to ".env.local" (same folder) for local development.
# 2. Fill in the 4 values below. Never commit .env.local or share it.
# 3. On Vercel, add the same 4 variables under Project → Settings → Environment Variables.
#
# Step-by-step instructions: PENDING_SETUP_AND_DEPLOYMENT_GUIDE.md
# ---------------------------------------------------------------------------

# The "client_email" value from your Google service account JSON key file.
# Example: family-finance@my-project-123456.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The "private_key" value from the same JSON file — copy it exactly,
# including the BEGIN/END lines and the \n characters, inside double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The long ID in your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# A random secret (at least 32 characters) used to sign login sessions.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
